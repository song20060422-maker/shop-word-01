# Shop 服务专用镜像（只服务 server/shop 业务，不构建管理端与前端）
FROM golang:1.26.10-alpine AS builder

WORKDIR /src

# 依赖层缓存
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/shop-server .

FROM alpine:3.20

RUN apk add --no-cache tzdata curl \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app
COPY --from=builder /out/shop-server /app/server
COPY --from=builder /src/config.shop-docker.yaml /app/config.shop-docker.yaml
COPY --from=builder /src/resource /app/resource

EXPOSE 8099
HEALTHCHECK --interval=10s --timeout=5s --retries=6 \
    CMD curl -fsS http://127.0.0.1:8099/api/health || exit 1

ENTRYPOINT ["/app/server", "-c", "/app/config.shop-docker.yaml"]
